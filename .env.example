# Kopieer naar .env voor lokaal testen (netlify dev). Nooit committen.
# In productie staan deze in Netlify → Project configuration → Environment variables.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NUKI_API_TOKEN=
NUKI_SMARTLOCK_ID=

RESEND_API_KEY=
MAIL_FROM="De Broekhof <info@debroekhof.nl>"

# Ondertekeningsgeheim (whsec_…) van de Resend-webhook "email.received" voor Micazu-mails
RESEND_WEBHOOK_SECRET=

# Gedeeld geheim voor micazu.gs (Apps Script) dat nieuwe Micazu-boekingen doorstuurt
MICAZU_GEHEIM=

# Geheim waarmee de geplande taak (planning.mjs) de dagelijkse actie aanroept
INTERN_GEHEIM=
