# Kopieer naar .env voor lokaal testen (netlify dev). Nooit committen.
# In productie staan deze in Netlify → Project configuration → Environment variables.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NUKI_API_TOKEN=
NUKI_SMARTLOCK_ID=

RESEND_API_KEY=
MAIL_FROM="De Broekhof <info@debroekhof.nl>"

# Ondertekeningsgeheim (whsec_…) van de Resend-webhook "email.received" voor Micazu-mails
RESEND_WEBHOOK_SECRET=

# Gedeeld geheim voor micazu.gs (Apps Script) dat nieuwe Micazu-boekingen doorstuurt
MICAZU_GEHEIM=

# Geheim waarmee de geplande taak (planning.mjs) de dagelijkse actie aanroept
INTERN_GEHEIM=

# OneDrive (persoonlijk Microsoft-account): app-registratie in Azure, zie handleiding.
# Bij het versturen van een bevestiging gaat de PDF ook naar OneDrive.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Map in OneDrive; daarin de map met het jaartal van aankomst (standaard "De Broekhof")
ONEDRIVE_MAP=

# Website-koppeling (website.mjs)
# iCal-export van De Broekhof in Micazu (bevat gastnamen: alleen hier bewaren)
MICAZU_ICAL_URL=
# Willekeurige sleutel voor de agenda die Micazu ophaalt: /api/ical?token=<deze waarde>
ICAL_EXPORT_TOKEN=
# Domeinen van de openbare website die de API vanuit de browser mogen gebruiken (komma-gescheiden)
WEBSITE_ORIGINS=https://debroekhof.nl,https://www.debroekhof.nl
